# PLANTILLA DE EJEMPLO (PUBLICA): no contiene contraseñas reales ni secretos.
# Copia este archivo como .env y cambia todos los valores CAMBIAR_POR_ antes de iniciar.
# No uses ni compartas los valores de ejemplo como credenciales.
MARIADB_ROOT_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA_ROOT
MARIADB_DATABASE=nextcloud
MARIADB_USER=nextcloud
MARIADB_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA_BASE_DE_DATOS

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA_ADMIN

NEXTCLOUD_PORT=8080
